# Copy sang .env trên VPS rồi điền giá trị THẬT. KHÔNG commit .env.
#   cp .env.example .env && nano .env
#
# Sinh mật khẩu/khóa mạnh:
#   openssl rand -base64 24    # cho password
#   openssl rand -base64 48    # cho JWT_SECRET (cần >= 32 byte)

# Tên miền — dùng cho Jwt Issuer/Audience, CORS, email seed
DOMAIN=tenmien.com

# SQL Server — tài khoản sa. Min 8 ký tự, có chữ hoa + số + ký tự đặc biệt
DB_PASSWORD=

# Redis
REDIS_PASSWORD=

# JWT — PHẢI >= 32 byte, nếu không app fail-fast lúc boot (Program.cs kiểm GetByteCount)
# ⚠️ Đổi khóa này = mọi token đang lưu hành vô hiệu, user phải đăng nhập lại
JWT_SECRET=

# Hangfire Dashboard — Basic Auth. Thiếu 2 biến này thì dashboard KHÔNG được mount.
# ⚠️ PHẢI khác mật khẩu tài khoản Admin của app
HANGFIRE_USER=hfadmin
HANGFIRE_PASSWORD=

# Tài khoản seed. Min 8 ký tự (Identity RequiredLength = 8)
ADMIN_PASSWORD=
CM_PASSWORD=

FRONTEND_BASE_URL=https://tenmien.com
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
