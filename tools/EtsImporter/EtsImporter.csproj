<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EtsImporter</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Tool chạy tay, CỐ Ý không nằm trong ToeicMasterPro.sln để không lọt vào
         build/test/CI của production. Cách chạy xem README.md cùng thư mục. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Tham chiếu Application để dùng CHUNG ToeicMediaNaming với server.
         Đây là lý do chọn C# thay vì Python: tool và server dùng đúng một hàm sinh tên
         file nên không thể lệch nhau. Viết lại quy ước bằng Python là tạo bản sao thứ
         hai, và bản sao sẽ lệch vào ngày ai đó sửa một bên. -->
    <ProjectReference Include="..\..\backend\ToeicMasterPro.Application\ToeicMasterPro.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Đọc text và ảnh nhúng từ PDF. Apache 2.0, không cần license key. -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

</Project>
